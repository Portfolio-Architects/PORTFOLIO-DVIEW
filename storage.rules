rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|avif|heic|heif)');
    }

    // Owner-scoped buckets: public read, owner raster image upload (<= 10MB, no SVG), owner/admin delete
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /reports/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /posts/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /reviews/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Service upload folders used by storage.service.ts (field_reports, user_reviews, user_pending_photos)
    match /field_reports/{fileName} {
      allow read: if true;
      allow create: if isSignedIn() && isValidImageUpload();
      allow update, delete: if isAdmin();
    }

    match /user_reviews/{fileName} {
      allow read: if true;
      allow create: if isSignedIn() && isValidImageUpload();
      allow update, delete: if isAdmin();
    }

    match /user_pending_photos/{fileName} {
      allow read: if true;
      allow create: if isValidImageUpload();
      allow update, delete: if isAdmin();
    }

    // Default rule: Restrict reads and writes to authenticated admins for undefined paths
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
