rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidImageUpload() {
      return request.resource != null
        && request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/(jpeg|jpg|png|webp|gif|avif|heic|heif)');
    }

    // Owner-scoped buckets: public read, owner raster image upload (<= 10MB, no SVG), owner/admin delete
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /reports/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /posts/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /reviews/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Existing production public image prefixes verified in bucket portfolio-dtdls.firebasestorage.app
    match /lounge_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /report_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /thumbnails/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Service upload folders with UID path isolation (field_reports, user_reviews, user_pending_photos)
    match /field_reports/{uid}/{fileName} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Legacy flat field_reports path: preserve public reads for existing images, lock writes to admin
    match /field_reports/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /user_reviews/{uid}/{fileName} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (request.auth.uid == uid || isAdmin());
    }

    // Legacy flat user_reviews path: preserve public reads for existing images, lock writes to admin
    match /user_reviews/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pre-moderation photo intake queue: authenticated uploader-scoped create/read only; admin manages moderation
    match /user_pending_photos/{uid}/{fileName} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid && isValidImageUpload();
      allow update, delete: if isAdmin();
    }

    // Legacy flat pending path locked down to admins (blocks unauthenticated 10MB public uploads)
    match /user_pending_photos/{fileName} {
      allow read, write: if isAdmin();
    }

    // Default rule: Restrict reads and writes to authenticated admins for undefined paths
    match /{allPaths=**} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
